# Copy this file to .env and fill in your key locally. Never put it in src/.
SUBTITLE_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
GROQ_API_KEY=
# Model defaults to gemini-3.5-flash-lite or openai/gpt-oss-120b by provider.
# SUBTITLE_JUDGE_MODEL=
JMDICT_PATH=.dictionary/jmdict-eng.json

# Optional cloud sync. Leave both blank for local-only flashcards.
# These public values are bundled into the frontend. Never use a secret or
# service_role key here. See MOBILE_SETUP.md for SQL and account setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
